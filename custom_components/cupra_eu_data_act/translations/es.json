  "exceptions": {
    "waiting_for_portal_data": {
      "message": "Inicio de sesión correcto — esperando el primer conjunto de datos del vehículo desde el portal EU Data Act. Esto es normal justo después de la configuración y no es un error de inicio de sesión.\n\nEn el portal ({portal_url}), comprueba lo siguiente:\n• Que haya una solicitud continua de datos de 15 minutos activa para este vehículo\n• Que el conjunto de datos sea **All Data** (no solo Charging)\n• Que el vehículo esté vinculado en Data clusters → Vehicle overview\n• Que el vehículo haya estado conectado recientemente (contacto puesto o conexión mediante app móvil)\n\nLos primeros datos reales suelen llegar en un plazo de 15 a 60 minutos, a veces unas pocas horas después de activar la solicitud. Las instantáneas vacías _no_content_found son normales cuando el coche no ha enviado telemetría en un intervalo de 15 minutos; se omiten automáticamente.\n\nHome Assistant reintentará cada {retry_minutes} minuto(s). No es necesario eliminar y volver a añadir la integración."
    },
    "waiting_for_portal_data_empty_snapshots": {
      "message": "Inicio de sesión correcto — la suscripción en el portal está activa, pero hasta ahora solo se han recibido instantáneas vacías ({empty_count} × _no_content_found). El vehículo aún no ha enviado telemetría en esos intervalos de 15 minutos.\n\nEsto no es un error de Home Assistant ni de inicio de sesión. En el portal ({portal_url}), confirma que la solicitud continua de 15 minutos está activada para este VIN y despierta el coche (conduciendo, dando el contacto o abriendo la app móvil) para que pueda subir datos.\n\nEl siguiente intervalo podría contener datos reales. Home Assistant reintentará cada {retry_minutes} minuto(s) — no es necesario eliminar la integración."
    },
    "delivery_not_ready": {
      "message": "Inicio de sesión correcto — la entrega de datos aún no está lista (HTTP 400). Si acabas de crear la solicitud continua de 15 minutos en el portal ({portal_url}), el servidor puede tardar unas horas en empezar a entregar archivos ZIP.\n\nHome Assistant reintentará cada {retry_minutes} minuto(s). No se trata de un problema de credenciales."
    },
    "config_entry_not_found": {
      "message": "Ninguna entrada de configuración de VW Group EU Data Act coincide con el vehículo seleccionado."
    },
    "no_config_entries": {
      "message": "No hay vehículos de VW Group EU Data Act configurados."
    },
    "no_loaded_entries": {
      "message": "La integración del vehículo seleccionado no está cargada."
    }
  },
  "services": {
    "refresh_now": {
      "name": "Actualizar ahora",
      "description": "Consulta inmediatamente el portal EU Data Act para obtener un nuevo conjunto de datos, sin esperar a la siguiente sincronización programada.",
      "fields": {
        "config_entry": {
          "name": "Vehículo",
          "description": "Vehículo a actualizar. Dejar vacío para actualizar todos los vehículos configurados."
        }
      }
    }
  },
  "issues": {
    "delivery_not_ready": {
      "title": "Entrega de datos no lista para {vehicle}",
      "description": "El portal EU Data Act aún no ha comenzado a entregar conjuntos de datos para este vehículo (HTTP 400). Si acabas de crear la solicitud continua de 15 minutos, el servidor puede tardar unas horas en activarse.\n\nAbre el portal ({portal_url}) y confirma que la suscripción está activa. Home Assistant reintentará cada {retry_minutes} minuto(s). Esto no es un problema de credenciales."
    },
    "waiting_for_portal_data": {
      "title": "Esperando el primer conjunto de datos para {vehicle}",
      "description": "Inicio de sesión correcto, pero aún no ha llegado ningún conjunto de datos del vehículo. En el portal ({portal_url}), confirma que la solicitud continua de datos de 15 minutos esté activa (conjunto de datos: **All Data**, no solo Charging), que el vehículo esté vinculado en Data clusters y que haya estado en línea recientemente.\n\nLos primeros datos suelen llegar en un plazo de 15 a 60 minutos. Home Assistant reintentará cada {retry_minutes} minuto(s)."
    },
    "empty_snapshots": {
      "title": "Solo instantáneas vacías para {vehicle}",
      "description": "La suscripción del portal está activa, pero hasta ahora solo se han recibido instantáneas vacías ({empty_count} × _no_content_found). Despierta el coche (conduciendo, dando el contacto o abriendo la app móvil) para que pueda enviar telemetría.\n\nHome Assistant reintentará cada {retry_minutes} minuto(s). Portal: {portal_url}"
    },
    "listing_failed": {
      "title": "No se pueden listar los conjuntos de datos para {vehicle}",
      "description": "Home Assistant no ha podido listar los conjuntos de datos en el portal EU Data Act ({portal_url}) — esto suele ser una interrupción temporal del servidor de origen (HTTP 5xx), no un fallo de inicio de sesión ni de suscripción.\n\nSe conservan los últimos valores conocidos del vehículo. Los reintentos se espaciarán automáticamente tras errores repetidos (5 → 15 → 30 minutos). Próximo reintento en unos {retry_minutes} minuto(s)."
    },
    "subscription_expiring_soon": {
      "title": "La suscripción del portal expirará pronto para {vehicle}",
      "description": "Se estima que la suscripción al portal EU Data Act caducará en {days_until} día(s). Las solicitudes continuas de datos deben renovarse en el portal o dejarán de recibirse conjuntos de datos.\n\nAbre el portal ({portal_url}) y renueva la suscripción antes de que expire."
    },
    "stale_snapshot": {
      "title": "Sin datos recientes del vehículo para {vehicle}",
      "description": "La última instantánea real del vehículo tiene una antigüedad aproximada de {hours_since} hora(s) ({minutes_since} minutos). Es posible que el coche esté sin conexión o que el portal no esté entregando nuevos datos.\n\nDespierta el coche (conduciendo, dando el contacto o abriendo la app móvil) y confirma que la solicitud continua está activa en el portal ({portal_url})."
    }
  },
